# Kraken API Configuration
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Trading Mode: "paper" or "live"
TRADING_MODE=paper

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db

# Backtesting data (optional)
# Directory of Kraken's downloadable tick CSVs, used by scripts/backtest.py to build
# candles locally instead of the REST API's ~720-candle cap. Leave empty to use --data-source rest.
KRAKEN_DATA_DIR=

# Risk Management
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_SIZE_PCT=5.0
MAX_DRAWDOWN_PCT=10.0
DEFAULT_STOP_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=5

# Who acts on a position's stop: off (nobody - only the strategy's own exit closes a
# trade), poll (the bot checks each cycle and sells at market), or native (a stop order
# rests on the exchange, protecting the position even while the bot is down). Exactly one
# enforces - both would sell the same position twice. Paper never uses native: the paper
# simulator has no resting orders.
#
# Ships off. Across 8 stop widths x 30 windows on 4h, no stop configuration beat leaving
# stops off and none reduced drawdown - see docs/backtest-results.md. Enable deliberately.
STOP_ENFORCEMENT=off

# One-step trailing ratchet: once price reaches TRIGGER above entry, the stop moves up
# to LOCK above entry and holds there. LOCK must be below TRIGGER. 0 disables it.
TRAILING_STOP_TRIGGER_PCT=0.0
TRAILING_STOP_LOCK_PCT=0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
